# Backward-compatible entry point (delegates to profile.sh)
if [ -n "$ZSH_VERSION" ]; then
  _DOTFILES_GENERAL_DIR="$(cd "$(dirname "${(%):-%x}")" && pwd)"
else
  _DOTFILES_GENERAL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
[[ -f "$_DOTFILES_GENERAL_DIR/profile.sh" ]] && source "$_DOTFILES_GENERAL_DIR/profile.sh"
unset _DOTFILES_GENERAL_DIR
